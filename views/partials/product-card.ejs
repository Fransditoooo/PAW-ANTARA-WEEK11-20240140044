<%
  const isAvailable = Number(product.stock) > 0;

  const badgeLabel = isAvailable
    ? 'Tersedia'
    : 'Habis';

  const badgeColor = isAvailable
    ? 'green'
    : 'red';

  const image =
    product.image ||
    'https://images.unsplash.com/photo-1472851294608-062f824d29cc?auto=format&fit=crop&w=800&q=85';
%>

<article
  class="
    product-card
    group
    overflow-hidden
    rounded-2xl
    bg-white
    dark:bg-gray-900
    border
    border-gray-200
    dark:border-gray-800
    shadow-sm
    hover:shadow-xl
    transition-all
    duration-300
  "
  data-stock="<%= product.stock %>"
>

  <!-- IMAGE -->

  <div
    class="
      relative
      h-64
      overflow-hidden
      bg-gray-100
      dark:bg-gray-800
    "
  >

    <img
      src="<%= image %>"
      alt="<%= product.name %>"
      class="
        w-full
        h-full
        object-cover
        group-hover:scale-105
        transition-transform
        duration-500
      "
      loading="lazy"
      onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1472851294608-062f824d29cc?auto=format&fit=crop&w=800&q=85';"
    >

    <!-- BADGE -->

    <div
      class="
        absolute
        top-3
        left-3
      "
    >

      <%- include('badge', {
        label: badgeLabel,
        color: badgeColor
      }) %>

    </div>

  </div>


  <!-- CONTENT -->

  <div class="p-5">

    <div class="mb-2">

      <h3
        class="
          text-lg
          font-bold
          text-gray-900
          dark:text-white
          line-clamp-1
        "
      >
        <%= product.name %>
      </h3>

    </div>


    <p
      class="
        text-sm
        leading-6
        text-gray-500
        dark:text-gray-400
        min-h-[48px]
        line-clamp-2
      "
    >
      <%= product.description || 'Produk berkualitas pilihan untuk kebutuhan sehari-hari.' %>
    </p>


    <!-- PRICE -->

    <div
      class="
        mt-4
        flex
        items-end
        justify-between
        gap-3
      "
    >

      <div>

        <p
          class="
            text-xs
            text-gray-400
            mb-1
          "
        >
          Harga
        </p>

        <p
          class="
            text-xl
            font-extrabold
            text-blue-600
            dark:text-blue-400
          "
        >
          Rp<%= Number(product.price).toLocaleString('id-ID') %>
        </p>

      </div>


      <div class="text-right">

        <p
          class="
            text-xs
            text-gray-400
          "
        >
          Stok
        </p>

        <p
          class="
            text-sm
            font-bold
            <%= isAvailable
              ? 'text-green-600'
              : 'text-red-500'
            %>
          "
        >
          <%= product.stock %>
        </p>

      </div>

    </div>


    <!-- BUTTON -->

    <button
      type="button"
      class="
        add-to-cart-btn
        mt-5
        w-full
        py-3
        rounded-xl
        text-sm
        font-bold
        transition-all
        duration-200
        <%= isAvailable
          ? 'bg-blue-600 hover:bg-blue-700 text-white hover:-translate-y-0.5'
          : 'bg-gray-200 dark:bg-gray-800 text-gray-400 cursor-not-allowed'
        %>
      "
      data-id="<%= product.id %>"
      data-name="<%= product.name %>"
      data-price="<%= product.price %>"
      data-stock="<%= product.stock %>"
      data-image="<%= image %>"
      <%= isAvailable ? '' : 'disabled' %>
    >

      <%= isAvailable
        ? '🛒 Tambah ke Keranjang'
        : 'Stok Habis'
      %>

    </button>

  </div>

</article>